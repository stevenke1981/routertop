#!/bin/sh
set -eu
# pppd sanitizes PATH; lifecycle tools live in sbin on Alpine.
export PATH=/sbin:/usr/sbin:/bin:/usr/bin
case "$1" in ppp0|ppp1) ;; *) exit 0;; esac
runtime=${6:?missing PPP runtime}
config=$(cat "$runtime/config-path")
# Capture this process incarnation at hook origin. A delayed old down hook
# cannot borrow a later ppp0/ppp1 session's identity.
pid=${PPPD_PID:-$PPID}
start=$(/bin/busybox awk '{ print $22 }' "/proc/$pid/stat")
export ROUTERTOP_PPP_SESSION="$pid-$start"
exec routertop pppoe-event "$config" "$runtime" ipv4-down "$1"
