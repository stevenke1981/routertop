# Local source package. Run packaging/make-source.sh, then abuild checksum.
# The generated checksum binds the exact source archive, including Cargo.lock.
pkgname=routertop
pkgver=0.6.0
pkgrel=0
pkgdesc="Compact Rust control plane for the RouterTop Linux router"
url="https://github.com/stevenke1981/routertop"
arch="x86_64 aarch64"
license="MIT"
depends="iproute2 nftables dnsmasq ifupdown-ng wireguard-tools-wg"
makedepends="cargo"
source="$pkgname-$pkgver.tar.gz"
builddir="$srcdir/$pkgname-$pkgver"

prepare() {
    default_prepare
    cargo fetch --locked
}

build() {
    cargo build --frozen --release
}

check() {
    cargo test --frozen
}

package() {
    install -Dm755 target/release/routertop "$pkgdir/usr/sbin/routertop"
    install -Dm644 configs/routertop.toml "$pkgdir/etc/routertop/routertop.toml"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/routertop/LICENSE"
}

# Populated by `abuild checksum` after generating the local source archive.
# An empty list is intentionally not a checksum bypass.
sha512sums=""
